<section class="section{% if section.settings.divider %} section--ruled{% endif %}">
  <div class="page-width art-transcends">
    <div class="section-header text-center art-transcends__header">
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="art-transcends__grid">
      {%- for block in section.blocks -%}
        {%- assign featured_product = block.settings.product -%}
        {%- assign artwork = block.settings.image | default: featured_product.featured_image -%}
        {%- if featured_product != blank -%}
          <a class="art-transcends__item" href="{{ featured_product.url }}" aria-label="View {{ featured_product.title | escape }}" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="art-transcends__item" {{ block.shopify_attributes }}>
        {%- endif -%}
            <div class="art-transcends__frame">
              {%- if artwork != blank -%}
                {{ artwork | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 31vw, 92vw', widths: '400, 600, 800, 1000, 1200', alt: artwork.alt | default: featured_product.title }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
        {%- if featured_product != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Art that transcends",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Art That Transcends" },
    { "type": "checkbox", "id": "divider", "label": "Line above section", "default": true }
  ],
  "blocks": [
    {
      "type": "artwork",
      "name": "Framed artwork",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Artwork override", "info": "Optional. Use when the product's featured image already includes a frame." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Art that transcends",
      "blocks": [
        { "type": "artwork" },
        { "type": "artwork" },
        { "type": "artwork" }
      ]
    }
  ]
}
{% endschema %}
