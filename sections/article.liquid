<article class="section" style="padding-top: 0">
  <header class="article-header page-width page-width--narrow">
    <span class="eyebrow">{{ article.published_at | date: '%B %-d, %Y' }}</span>
    <h1>{{ article.title }}</h1>
  </header>
  {%- if article.image -%}
    <div class="page-width article__image">
      {{ article.image | image_url: width: 2000 | image_tag: sizes: '100vw', widths: '750, 1100, 1500, 2000', alt: article.image.alt | default: article.title }}
    </div>
  {%- endif -%}
  <div class="page-width page-width--narrow">
    <div class="rte article__content">
      {%- assign article_title_lowercase = article.title | downcase -%}
      {%- if article_title_lowercase contains 'wynn lane' -%}
        <figure class="article__inline-image article__inline-image--left">
          <img
            src="{{ 'gallery-front-black-and-white.jpg' | asset_url }}"
            alt="Exterior of Joseph Rowland's fine art photography gallery on Wynn Lane"
            width="3495"
            height="2621"
            loading="lazy"
          >
        </figure>
      {%- endif -%}
      {{ article.content }}
    </div>
    <p style="margin-top: 3rem"><a class="link-arrow" href="{{ blog.url }}">&larr; Back to {{ blog.title }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Blog post",
  "settings": []
}
{% endschema %}
