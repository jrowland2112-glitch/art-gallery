<section class="section" style="padding-top: 0">
  <div class="page-width">
    <div class="collection-hero text-center"><h1>{{ section.settings.heading | default: blog.title }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      <div class="grid" style="--cols: 3; --cols-mobile: 1;">
        {%- for article in blog.articles -%}
          <a class="card" href="{{ article.url }}" style="--ratio: 3 / 2">
            <div class="card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 900' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="card__info">
              <div class="card__meta">{{ article.published_at | date: '%B %-d, %Y' }}</div>
              <h2 class="card__title">{{ article.title }}</h2>
              <p class="card__meta">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </div>
          </a>
        {%- else -%}
          <p class="muted">No posts yet.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pages">{{ paginate | default_pagination: previous: '&larr;', next: '&rarr;' }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Page heading", "info": "Defaults to the blog title when left blank" }
  ]
}
{% endschema %}
