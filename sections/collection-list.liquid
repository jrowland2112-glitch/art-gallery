<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="grid" style="--cols: {{ section.settings.columns }}; --cols-mobile: 1;">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign img = block.settings.image | default: c.featured_image -%}
        <a class="card" href="{{ c.url | default: '#' }}" style="--ratio: 3 / 4" {{ block.shopify_attributes }}>
          <div class="card__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 800, 1000' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="card__info">
            <h3 class="card__title">{{ block.settings.title | default: c.title | default: 'Collection name' }}</h3>
            {%- if c != blank -%}<div class="card__meta">{{ c.products_count }} prints</div>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the collections" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title (optional)", "info": "Defaults to the collection name" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Defaults to the collection image" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "Landscapes" } },
        { "type": "collection", "settings": { "title": "Wildlife" } },
        { "type": "collection", "settings": { "title": "Black & White" } }
      ]
    }
  ]
}
{% endschema %}
