<section class="section collection-page" style="padding-top: 0">
  <div class="page-width">
    <div class="collection-hero text-center">
      <h1>{%- if collection.handle == 'all' -%}{{ section.settings.all_title }}{%- else -%}{{ collection.title }}{%- endif -%}</h1>
      {%- if collection.description != blank -%}<div class="rte muted page-width--narrow" style="margin: 0 auto">{{ collection.description }}</div>{%- endif -%}
    </div>

    {%- if section.settings.show_location_filter -%}
      {%- liquid
        assign location_tags = section.settings.location_tags | split: ','
        assign available_location_count = 0
        for location_tag in location_tags
          assign clean_location_tag = location_tag | strip
          if collection.all_tags contains clean_location_tag
            assign available_location_count = available_location_count | plus: 1
          endif
        endfor
      -%}
      {%- if available_location_count > 0 -%}
        <nav class="gallery-locations" aria-label="Browse prints by location">
          <span class="gallery-locations__label">Browse by location</span>
          <div class="gallery-locations__list">
            <a class="gallery-location{% if current_tags == blank %} is-active{% endif %}" href="{{ collection.url }}"{% if current_tags == blank %} aria-current="page"{% endif %}>All locations</a>
            {%- for location_tag in location_tags -%}
              {%- liquid
                assign clean_location_tag = location_tag | strip
                assign location_handle = clean_location_tag | handleize
                assign location_is_active = false
                if current_tags contains clean_location_tag
                  assign location_is_active = true
                endif
              -%}
              {%- if collection.all_tags contains clean_location_tag -%}
                <a class="gallery-location{% if location_is_active %} is-active{% endif %}" href="{{ collection.url }}/{{ location_handle }}"{% if location_is_active %} aria-current="page"{% endif %}>{{ clean_location_tag }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </nav>
      {%- endif -%}
    {%- endif -%}

    {%- paginate collection.products by section.settings.per_page -%}
      <div class="toolbar">
        <span>{%- if collection.products_count > 0 -%}{{ collection.products_count }} prints{%- endif -%}</span>
        {%- if section.settings.show_sort -%}
          {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          <label>
            <span class="visually-hidden">Sort by</span>
            <select data-sort-by>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
      </div>

      <div class="grid{% if collection.handle == 'all' %} shop-results__grid{% endif %}" style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, ratio: section.settings.ratio, contain: section.settings.contain %}
        {%- else -%}
          {%- for i in (1..6) -%}
            {% render 'product-card', index: i, ratio: section.settings.ratio %}
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pages">{{ paginate | default_pagination: previous: '&larr;', next: '&rarr;' }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "text", "id": "all_title", "label": "Title of the all-prints page", "default": "The Gallery" },
    { "type": "range", "id": "per_page", "min": 6, "max": 48, "step": 3, "label": "Prints per page", "default": 24 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on phone", "default": "1", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    {
      "type": "select", "id": "ratio", "label": "Image shape", "default": "4 / 5",
      "options": [ { "value": "4 / 5", "label": "Portrait" }, { "value": "1 / 1", "label": "Square" }, { "value": "3 / 2", "label": "Landscape" } ]
    },
    { "type": "checkbox", "id": "contain", "label": "Show whole image (no cropping)", "default": false },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true },
    { "type": "checkbox", "id": "show_location_filter", "label": "Show Browse by location", "default": true },
    { "type": "textarea", "id": "location_tags", "label": "Location tags", "info": "Enter tags separated by commas. Only tags used by products in this collection are shown.", "default": "Alaska, Banff, Florida, Grand Tetons, Long Island, Maine, New York City, Ricketts Glen, Vermont, Washington DC, West Virginia" }
  ]
}
{% endschema %}
