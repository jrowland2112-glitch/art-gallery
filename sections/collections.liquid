<section class="section">
  <div class="page-width">
    <div class="collection-hero text-center" style="padding-top: 0"><h1>{{ section.settings.heading }}</h1></div>
    <div class="grid" style="--cols: 3; --cols-mobile: 1;">
      {%- for c in collections -%}
        {%- if c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <a class="card" href="{{ c.url }}" style="--ratio: 3 / 4">
          <div class="card__media">
            {%- if c.featured_image -%}
              {{ c.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 800, 1000' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="card__info">
            <h2 class="card__title">{{ c.title }}</h2>
            <div class="card__meta">{{ c.products_count }} prints</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "All collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
