{%- assign blog = section.settings.blog -%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <h2>{{ section.settings.heading }}</h2>
      {%- if blog != blank -%}<a class="link-arrow" href="{{ blog.url }}">All stories</a>{%- endif -%}
    </div>
    <div class="grid" style="--cols: 3; --cols-mobile: 1;">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.limit -%}
          <a class="card" href="{{ article.url }}" style="--ratio: 3 / 2">
            <div class="card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 900' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="card__info">
              <div class="card__meta">{{ article.published_at | date: '%B %-d, %Y' }}</div>
              <h3 class="card__title">{{ article.title }}</h3>
              <p class="card__meta">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <div class="card" style="--ratio: 3 / 2">
            <div class="card__media">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__info">
              <div class="card__meta">Month Day, Year</div>
              <h3 class="card__title">Story from the field</h3>
              <p class="card__meta">Blog posts appear here once you write them in Content → Blog posts.</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Latest blog posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "min": 1, "max": 6, "step": 1, "label": "Number of posts", "default": 3 },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "presets": [ { "name": "Latest blog posts" } ]
}
{% endschema %}
