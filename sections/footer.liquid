<footer class="site-footer">
  <div class="page-width">
    {%- if section.settings.show_menu or section.settings.show_newsletter -%}
      <div class="site-footer__grid">
        {%- if section.settings.show_menu -%}
          <div>
            <h2>{{ section.settings.menu_heading }}</h2>
            <ul>
              {%- for link in section.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if section.settings.show_newsletter -%}
          <div>
            <h2>{{ section.settings.newsletter_heading }}</h2>
            <p class="muted">{{ section.settings.newsletter_text }}</p>
            {%- form 'customer', id: 'footer-newsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-message">Thanks for subscribing.</p>
              {%- else -%}
                {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
                <div class="newsletter-form">
                  <label class="visually-hidden" for="footer-newsletter-email">Email</label>
                  <input id="footer-newsletter-email" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
                  <button class="button" type="submit">Join</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="site-footer__bottom">
      <a class="site-footer__brand" href="{{ routes.root_url }}" aria-label="Rowland Photography home">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 360 | image_tag: alt: 'Rowland Photography' }}
        {%- else -%}
          <img src="{{ 'rowland-photography-logo.png' | asset_url }}" width="912" height="268" alt="Rowland Photography">
        {%- endif -%}
      </a>
      <span>&copy; {{ section.settings.copyright_name | default: shop.name }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Name on the left", "default": "Rowland Photography" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Joseph Rowland" },
    { "type": "checkbox", "id": "show_menu", "label": "Show footer menu", "default": false },
    { "type": "text", "id": "menu_heading", "label": "Menu heading", "default": "Info" },
    { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer", "info": "Good for Shipping, Returns, Contact, and policy links" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email sign-up", "default": false },
    { "type": "text", "id": "newsletter_heading", "label": "Sign-up heading", "default": "Stay in touch" },
    { "type": "text", "id": "newsletter_text", "label": "Sign-up text", "default": "New work and print releases, a few times a year." }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
