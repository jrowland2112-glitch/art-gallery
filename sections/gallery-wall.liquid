<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section-header">
        <div>
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p class="muted" style="margin: .5rem 0 0">{{ section.settings.text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <div class="gallery-wall" style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_mobile }};">
      {%- for block in section.blocks -%}
        {%- assign link = block.settings.link | default: block.settings.product.url -%}
        <figure class="gallery-wall__item" {{ block.shopify_attributes }}>
          {%- if link != blank -%}<a href="{{ link }}">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 900, 1200', alt: block.settings.image.alt | default: block.settings.title }}
          {%- else -%}
            {%- assign n = forloop.index | modulo: 2 | plus: 1 -%}
            {%- assign placeholder_name = 'lifestyle-' | append: n -%}
            {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if block.settings.title != blank or block.settings.caption != blank -%}
            <figcaption>
              {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong>{%- endif -%}
              {{ block.settings.caption }}
            </figcaption>
          {%- endif -%}
          {%- if link != blank -%}</a>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Photo gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gallery" },
    { "type": "text", "id": "text", "label": "Description" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on phone", "default": "1", "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "e.g. location and year" },
        { "type": "product", "id": "product", "label": "Link to print (optional)", "info": "Clicking the photo opens this print's page" },
        { "type": "url", "id": "link", "label": "Or link to any page (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Photo gallery",
      "blocks": [
        { "type": "photo", "settings": { "title": "Untitled I", "caption": "Location, 2026" } },
        { "type": "photo", "settings": { "title": "Untitled II", "caption": "Location, 2026" } },
        { "type": "photo", "settings": { "title": "Untitled III", "caption": "Location, 2026" } },
        { "type": "photo", "settings": { "title": "Untitled IV", "caption": "Location, 2026" } },
        { "type": "photo", "settings": { "title": "Untitled V", "caption": "Location, 2026" } },
        { "type": "photo", "settings": { "title": "Untitled VI", "caption": "Location, 2026" } }
      ]
    }
  ]
}
{% endschema %}
