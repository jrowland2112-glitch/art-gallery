<header class="site-header site-header--{{ section.settings.logo_position }}{% if section.settings.sticky %} site-header--sticky{% endif %}">
  <div class="page-width site-header__inner">
    <details class="menu-drawer">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
      </summary>
      <nav class="menu-drawer__panel" aria-label="Mobile">
        <ul>
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    </details>

    <a class="site-header__logo" href="{{ routes.root_url }}" style="--logo-width: {{ settings.logo_width }}px">
      {%- if settings.logo != blank -%}
        {%- assign logo_width_2x = settings.logo_width | times: 2 -%}
        {{ settings.logo | image_url: width: logo_width_2x | image_tag: alt: shop.name }}
      {%- else -%}
        <p class="site-header__logo-text">{{ shop.name }}</p>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{{ routes.account_url }}" aria-label="Account">{{ 'icon-account.svg' | inline_asset_content }}</a>
      {%- endif -%}
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        {{ 'icon-cart.svg' | inline_asset_content }}
        {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Edit menus in Online Store → Navigation" },
    {
      "type": "select", "id": "logo_position", "label": "Logo position on desktop", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "checkbox", "id": "sticky", "label": "Keep header visible when scrolling", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": false }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
