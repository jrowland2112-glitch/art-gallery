{%- liquid
  assign menu = section.settings.menu
  assign use_fallback = true
  if menu != blank and menu.links.size > 0
    assign use_fallback = false
  endif
-%}
{%- capture nav_links -%}
  {%- if use_fallback -%}
    <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
    <li><a href="/blogs/journal">Blog</a></li>
    <li><a href="/pages/about">About</a></li>
  {%- else -%}
    {%- for link in menu.links -%}
      <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}">
  <div class="page-width">
    <div class="site-header__inner">
      <a class="site-header__logo" href="{{ routes.root_url }}" style="--logo-width: {{ settings.logo_width }}px">
        {%- if settings.logo != blank -%}
          {%- assign logo_width_2x = settings.logo_width | times: 2 -%}
          {{ settings.logo | image_url: width: logo_width_2x | image_tag: alt: shop.name }}
        {%- else -%}
          <span class="wordmark">
            <span class="wordmark__name">{{ section.settings.wordmark_name | default: shop.name }}</span>
            {%- if section.settings.wordmark_subtitle != blank -%}
              <span class="wordmark__sub">{{ section.settings.wordmark_subtitle }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </a>

      <nav class="site-header__nav" aria-label="Main">
        <ul>{{ nav_links }}</ul>
      </nav>

      <div class="site-header__icons">
        {%- if section.settings.show_instagram and settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon-instagram' %}</a>
        {%- elsif section.settings.show_instagram -%}
          <a href="#" aria-label="Instagram (add your link in Theme settings → Social media)">{% render 'icon-instagram' %}</a>
        {%- endif -%}
        {%- if section.settings.show_cart or cart.item_count > 0 -%}
          <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
            {{ 'icon-cart.svg' | inline_asset_content }}
            {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
          </a>
        {%- endif -%}
        <details class="menu-drawer">
          <summary aria-label="Menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          </summary>
          <nav class="menu-drawer__panel" aria-label="Mobile">
            <ul>{{ nav_links }}</ul>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "wordmark_name", "label": "Logo name", "default": "Rowland", "info": "Shown in script when no logo image is uploaded (Theme settings → Logo)" },
    { "type": "text", "id": "wordmark_subtitle", "label": "Logo subtitle", "default": "Photography" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Edit in Online Store → Navigation. If empty, shows Shop, Blog, and About." },
    { "type": "checkbox", "id": "show_instagram", "label": "Show Instagram icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Always show cart icon", "default": false, "info": "When off, the cart icon only appears once something is in the cart" },
    { "type": "checkbox", "id": "sticky", "label": "Keep header visible when scrolling", "default": false }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
