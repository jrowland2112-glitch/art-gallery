{%- liquid
  case section.settings.text_position
    when 'center'
      assign v = 'center'
      assign h = 'center'
      assign ta = 'center'
    when 'bottom-center'
      assign v = 'end'
      assign h = 'center'
      assign ta = 'center'
    else
      assign v = 'end'
      assign h = 'start'
      assign ta = 'left'
  endcase
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}
<section class="hero hero--{{ section.settings.height }}" style="--overlay: {{ overlay }}; --v-align: {{ v }}; --h-align: {{ h }}; --text-align: {{ ta }};">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 3000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2200, 3000' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color: inherit; opacity: .85">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      {%- if section.index == 1 -%}<h1>{{ section.settings.heading }}</h1>{%- else -%}<h2 class="h1">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- endif -%}
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="button button--outline-light" href="{{ section.settings.button2_link | default: routes.root_url }}">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Large image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape images work best (at least 2400px wide)" },
    {
      "type": "select", "id": "height", "label": "Height", "default": "large",
      "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Full screen" } ]
    },
    {
      "type": "select", "id": "text_position", "label": "Text position", "default": "bottom-left",
      "options": [ { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image darkening", "default": 25, "info": "Makes text easier to read" },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Fine art photography" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Moments of light, made to last" },
    { "type": "text", "id": "text", "label": "Text", "default": "Limited edition prints, crafted on museum-grade paper." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop prints" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "View gallery" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [ { "name": "Large image banner" } ]
}
{% endschema %}
