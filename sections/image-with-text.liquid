<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="split split--image-{{ section.settings.image_position }} split--align-{{ section.settings.vertical_alignment }}">
      <div class="split__media">
        {%- if section.settings.image_asset != blank -%}
          <img
            src="{{ section.settings.image_asset | asset_url }}"
            width="1600"
            height="2471"
            loading="lazy"
            alt="{{ section.settings.heading | escape }}"
          >
        {%- elsif section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="split__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.signature_asset != blank -%}
          <img
            class="split__signature-image"
            src="{{ section.settings.signature_asset | asset_url }}"
            width="2172"
            height="724"
            loading="lazy"
            alt="{{ section.settings.signature | default: 'Signature' | escape }}"
          >
        {%- elsif section.settings.signature != blank -%}
          <p class="split__signature">{{ section.settings.signature }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <p style="margin-top: 1.75rem"><a class="button button--secondary" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a></p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Theme image filename (advanced)", "info": "When set, this theme asset is shown instead of the image above" },
    {
      "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
    },
    {
      "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "default": "center",
      "options": [ { "value": "center", "label": "Centered" }, { "value": "top", "label": "Top aligned" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "About the artist" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Behind the lens" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here: what you photograph, why, and where your work has taken you. Visitors who connect with the story behind the art are far more likely to buy a print.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "info": "Optional handwritten-style name shown beneath the text" },
    { "type": "text", "id": "signature_asset", "label": "Signature image filename (advanced)", "info": "Optional theme asset shown instead of the signature text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
