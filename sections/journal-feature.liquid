{%- assign blog = section.settings.blog -%}
<section class="section{% if section.settings.divider %} section--ruled{% endif %}">
  <div class="page-width">
    <div class="journal-feature">
      <div class="journal-feature__intro">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow eyebrow--highlight">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="display-italic">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte journal-feature__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="text-link" href="{{ section.settings.link | default: blog.url | default: '/blogs/news' }}">{{ section.settings.link_label }} <span aria-hidden="true">&#8599;</span></a>
        {%- endif -%}
      </div>

      {%- liquid
        assign cols = section.settings.limit
        if section.blocks.size > 0
          assign cols = section.blocks.size
        endif
      -%}
      <div class="journal-feature__posts" style="--cols: {{ cols }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign a = block.settings.article
              assign card_image = block.settings.image | default: a.image
              assign card_title = block.settings.title | default: a.title
              assign card_url = block.settings.link | default: a.url | default: blog.url | default: '/blogs/news'
            -%}
            <a class="journal-card" href="{{ card_url }}" {{ block.shopify_attributes }}>
              <div class="journal-card__media">
                {%- if card_image != blank -%}
                  {{ card_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 800, 1000', alt: card_title }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="journal-card__title">{{ card_title }}</p>
            </a>
          {%- endfor -%}
        {%- elsif blog != blank and blog.articles_count > 0 -%}
          {%- for article in blog.articles limit: section.settings.limit -%}
            <a class="journal-card" href="{{ article.url }}">
              <div class="journal-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 800, 1000', alt: article.image.alt | default: article.title }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p class="journal-card__title">{{ article.title }}</p>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- assign sample_titles = 'Chasing autumn in Vermont|Finding stillness on Long Island|Notes from the road' | split: '|' -%}
          {%- for i in (1..section.settings.limit) -%}
            {%- assign idx = i | minus: 1 -%}
            {%- assign n = i | modulo: 2 | plus: 1 -%}
            {%- assign placeholder_name = 'lifestyle-' | append: n -%}
            <a class="journal-card" href="{{ blog.url | default: '/blogs/news' }}">
              <div class="journal-card__media">{{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <p class="journal-card__title">{{ sample_titles[idx] }}</p>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal highlight",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories behind the frame." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The places, the light, and the moments that make the photograph.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore The Journal" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the selected blog" },
    { "type": "blog", "id": "blog", "label": "Blog to show posts from" },
    { "type": "range", "id": "limit", "min": 1, "max": 3, "step": 1, "label": "Number of posts", "default": 2, "info": "Used when no Story cards are added below. Then the newest blog posts are shown automatically." },
    { "type": "checkbox", "id": "divider", "label": "Line above section", "default": true }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story card",
      "settings": [
        { "type": "article", "id": "article", "label": "Blog post", "info": "Pick a post to link to. Its photo and title are used unless you set your own below." },
        { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "url", "id": "link", "label": "Custom link (optional)", "info": "Overrides the blog post link" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "Journal highlight" } ]
}
{% endschema %}
