{% comment %}
  Branded password landing page shown while storefront password protection is enabled.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_strong = overlay_opacity | plus: 0.18 | at_most: 1
  assign overlay_soft = overlay_opacity | times: 0.55
-%}

<section
  class="password-hero"
  style="--password-overlay-opacity: {{ overlay_opacity }}; --password-overlay-strong: {{ overlay_strong }}; --password-overlay-soft: {{ overlay_soft }};"
>
  <div class="password-hero__media" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1200, 1800, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    {%- else -%}
      <img
        src="{{ 'password-trillium-lake.jpg' | asset_url }}"
        width="2400"
        height="1600"
        loading="eager"
        fetchpriority="high"
        alt=""
      >
    {%- endif -%}
  </div>

  <div class="password-hero__content">
    <div class="password-hero__panel">
      <h1 class="password-hero__title">
        <span class="password-hero__brand">{{ section.settings.brand | escape }}</span>
        <span>{{ section.settings.heading | escape }}</span>
      </h1>
      <p class="password-hero__status">{{ section.settings.status | escape }}</p>

      {% form 'storefront_password', class: 'password-hero__form' %}
        {% if form.errors %}
          <div class="password-hero__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label class="visually-hidden" for="password-input">
          {{ 'password.password' | t }}
        </label>
        <div class="password-hero__field">
          <input
            type="password"
            name="password"
            id="password-input"
            autocomplete="current-password"
            placeholder="{{ 'password.password' | t }}"
            required
          >
          <button type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coming soon page",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Trillium Lake is used when no replacement image is selected."
    },
    {
      "type": "text",
      "id": "brand",
      "label": "Brand line",
      "default": "Rowland Photography:"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From Wynn Lane to Online…"
    },
    {
      "type": "text",
      "id": "status",
      "label": "Status",
      "default": "Coming Soon"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    }
  ]
}
{% endschema %}
