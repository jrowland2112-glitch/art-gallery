{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign main_image = current_variant.featured_image | default: product.featured_image
  assign reference_image = product.featured_image | default: main_image
  assign metal_mockup_orientation = 'landscape'
  assign metal_mockup_asset = 'metal-lifestyle-landscape.jpg'
  assign metal_edge_asset = 'metal-edge-landscape.jpg'
  assign gallery_wrap_mockup_asset = 'gallery-wrap-lifestyle-landscape.jpg'
  assign gallery_wrap_edge_asset = 'gallery-wrap-edge-landscape.jpg'
  assign framed_mockup_asset = 'framed-lifestyle-landscape.jpg'
  assign framed_edge_asset = 'framed-edge-landscape.jpg'
  if reference_image and reference_image.aspect_ratio < 1
    assign metal_mockup_orientation = 'portrait'
    assign metal_mockup_asset = 'metal-lifestyle-portrait.jpg'
    assign metal_edge_asset = 'metal-edge-portrait.jpg'
    assign gallery_wrap_mockup_asset = 'gallery-wrap-lifestyle-portrait.jpg'
    assign gallery_wrap_edge_asset = 'gallery-wrap-edge-portrait.jpg'
    assign framed_mockup_asset = 'framed-lifestyle-portrait.jpg'
    assign framed_edge_asset = 'framed-edge-portrait.jpg'
  endif
  assign form_id = 'product-form-' | append: section.id
  assign use_frame_preview = section.settings.frame_preview
  for product_option_name in product.options
    assign product_option_name_lower = product_option_name | downcase
    if product_option_name_lower == 'title'
      assign use_frame_preview = false
    endif
  endfor
-%}
<section
  class="section product-section"
  data-product
  data-finish-option="{{ section.settings.finish_option_name | escape }}"
  data-frame-option="{{ section.settings.frame_option_name | escape }}"
  data-mat-option="{{ section.settings.mat_option_name | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="page-width">
    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">The Gallery</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product">
    <div class="product__media">
      <div class="product__stage">
        <div class="frame-preview" {% if use_frame_preview %}data-frame-preview{% endif %}>
          {%- if main_image -%}
            <img
              data-main-image
              src="{{ main_image | image_url: width: 1600 }}"
              srcset="{{ main_image | image_url: width: 800 }} 800w, {{ main_image | image_url: width: 1200 }} 1200w, {{ main_image | image_url: width: 1600 }} 1600w"
              sizes="(min-width: 990px) 55vw, 100vw"
              width="{{ main_image.width }}"
              height="{{ main_image.height }}"
              alt="{{ main_image.alt | default: product.title | escape }}"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if main_image -%}
          <button class="product__enlarge" type="button" data-product-lightbox-open aria-haspopup="dialog">
            <svg class="product__enlarge-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="10.5" cy="10.5" r="6.5"></circle>
              <path d="m15.5 15.5 5 5"></path>
            </svg>
            Enlarge
          </button>
        {%- endif -%}
        {%- if reference_image -%}
          <div class="product__stage-copy">
            {%- if section.settings.stage_caption != blank -%}
              <p class="product__stage-caption" data-finish-caption>{{ section.settings.stage_caption }}</p>
            {%- endif -%}
            <p class="frame-preview__note">Frame and mat preview is for illustration. Actual finish may vary slightly.</p>
          </div>
          <div class="metal-lifestyle-grid gallery-wrap-preview-grid" data-gallery-wrap-preview hidden>
            <figure class="metal-lifestyle metal-lifestyle--{{ metal_mockup_orientation }}">
              <button class="metal-lifestyle__open" type="button" data-gallery-wrap-open aria-haspopup="dialog" aria-label="Enlarge {{ product.title | escape }} gallery wrap lifestyle preview">
                <div class="metal-lifestyle__visual" data-gallery-wrap-visual data-gallery-wrap-layout="wall" data-gallery-wrap-orientation="{{ metal_mockup_orientation }}">
                  <img class="metal-lifestyle__scene" src="{{ gallery_wrap_mockup_asset | asset_url }}" width="1400" height="1120" loading="lazy" alt="">
                  <div class="gallery-wrap__panel">
                    <img class="metal-lifestyle__art" src="{{ reference_image | image_url: width: 1600 }}" srcset="{{ reference_image | image_url: width: 800 }} 800w, {{ reference_image | image_url: width: 1200 }} 1200w, {{ reference_image | image_url: width: 1600 }} 1600w" sizes="(min-width: 990px) 38vw, 82vw" width="{{ reference_image.width }}" height="{{ reference_image.height }}" loading="lazy" alt="{{ product.title | escape }} shown as a black-sided gallery wrap being hung on a wall">
                    <span class="gallery-wrap__texture" aria-hidden="true"></span>
                  </div>
                </div>
              </button>
              <figcaption>Gallery wrap &middot; Lifestyle preview &middot; Click to enlarge</figcaption>
            </figure>
            <figure class="metal-lifestyle metal-lifestyle--edge metal-lifestyle--{{ metal_mockup_orientation }}">
              <button class="metal-lifestyle__open" type="button" data-gallery-wrap-open aria-haspopup="dialog" aria-label="Enlarge {{ product.title | escape }} gallery wrap edge detail">
                <div class="metal-lifestyle__visual" data-gallery-wrap-visual data-gallery-wrap-layout="edge" data-gallery-wrap-orientation="{{ metal_mockup_orientation }}">
                  <img class="metal-lifestyle__scene" src="{{ gallery_wrap_edge_asset | asset_url }}" width="1400" height="1120" loading="lazy" alt="">
                  <div class="gallery-wrap__panel">
                    <img class="metal-lifestyle__art" src="{{ reference_image | image_url: width: 1600 }}" srcset="{{ reference_image | image_url: width: 800 }} 800w, {{ reference_image | image_url: width: 1200 }} 1200w, {{ reference_image | image_url: width: 1600 }} 1600w" sizes="(min-width: 990px) 24vw, 48vw" width="{{ reference_image.width }}" height="{{ reference_image.height }}" loading="lazy" alt="{{ product.title | escape }} shown from the edge as a black-sided gallery wrap">
                    <span class="gallery-wrap__texture" aria-hidden="true"></span>
                  </div>
                </div>
              </button>
              <figcaption>Gallery wrap &middot; Black edge detail &middot; Click to enlarge</figcaption>
            </figure>
            <figure class="metal-lifestyle metal-lifestyle--room metal-lifestyle--{{ metal_mockup_orientation }}">
              <button class="metal-lifestyle__open" type="button" data-gallery-wrap-open aria-haspopup="dialog" aria-label="Enlarge {{ product.title | escape }} gallery wrap room-scale preview">
                <div class="metal-lifestyle__visual" data-gallery-wrap-visual data-gallery-wrap-layout="room" data-gallery-wrap-orientation="{{ metal_mockup_orientation }}">
                  <img class="metal-lifestyle__scene" src="{{ 'metal-room-couch.jpg' | asset_url }}" width="1400" height="1120" loading="lazy" alt="">
                  <div class="gallery-room__panel">
                    <img class="metal-lifestyle__art" src="{{ reference_image | image_url: width: 1600 }}" srcset="{{ reference_image | image_url: width: 800 }} 800w, {{ reference_image | image_url: width: 1200 }} 1200w, {{ reference_image | image_url: width: 1600 }} 1600w" sizes="(min-width: 990px) 18vw, 32vw" width="{{ reference_image.width }}" height="{{ reference_image.height }}" loading="lazy" alt="{{ product.title | escape }} shown to scale as a black-sided gallery wrap above a six-foot sofa">
                    <span class="gallery-wrap__texture" aria-hidden="true"></span>
                  </div>
                </div>
              </button>
              <figcaption>Gallery wrap &middot; Room scale above a 6-foot sofa &middot; Click to enlarge</figcaption>
            </figure>
            <dialog class="metal-lifestyle-lightbox" data-gallery-wrap-lightbox aria-label="Enlarged {{ product.title | escape }} gallery wrap preview">
              <button class="metal-lifestyle-lightbox__close" type="button" data-gallery-wrap-close aria-label="Close enlarged gallery wrap preview"><span aria-hidden="true">&times;</span><span>Close</span></button>
              <div class="metal-lifestyle-lightbox__content" data-gallery-wrap-lightbox-content></div>
            </dialog>
          </div>
          <div class="metal-lifestyle-grid framed-preview-grid" data-framed-preview hidden>
            <figure class="metal-lifestyle metal-lifestyle--{{ metal_mockup_orientation }}">
              <button class="metal-lifestyle__open" type="button" data-framed-preview-open aria-haspopup="dialog" aria-label="Enlarge {{ product.title | escape }} framed lifestyle preview">
                <div class="metal-lifestyle__visual" data-framed-visual data-framed-layout="wall" data-framed-orientation="{{ metal_mockup_orientation }}">
                  <img class="metal-lifestyle__scene" src="{{ framed_mockup_asset | asset_url }}" width="1400" height="1120" loading="lazy" alt="">
                  <div class="framed-preview__art-panel"><img class="metal-lifestyle__art" src="{{ reference_image | image_url: width: 1600 }}" width="{{ reference_image.width }}" height="{{ reference_image.height }}" loading="lazy" alt="{{ product.title | escape }} shown in a slim black wood frame with a double-white mat"></div>
                </div>
              </button>
              <figcaption>Framed art &middot; Lifestyle preview &middot; Click to enlarge</figcaption>
            </figure>
            <figure class="metal-lifestyle metal-lifestyle--edge metal-lifestyle--{{ metal_mockup_orientation }}">
              <button class="metal-lifestyle__open" type="button" data-framed-preview-open aria-haspopup="dialog" aria-label="Enlarge {{ product.title | escape }} framed edge detail">
                <div class="metal-lifestyle__visual" data-framed-visual data-framed-layout="edge" data-framed-orientation="{{ metal_mockup_orientation }}">
                  <img class="metal-lifestyle__scene" src="{{ framed_edge_asset | asset_url }}" width="1400" height="1120" loading="lazy" alt="">
                  <div class="framed-preview__art-panel"><img class="metal-lifestyle__art" src="{{ reference_image | image_url: width: 1600 }}" width="{{ reference_image.width }}" height="{{ reference_image.height }}" loading="lazy" alt="{{ product.title | escape }} shown in a slim black wood frame from the edge"></div>
                </div>
              </button>
              <figcaption>Framed art &middot; Frame and mat detail &middot; Click to enlarge</figcaption>
            </figure>
            <figure class="metal-lifestyle metal-lifestyle--room metal-lifestyle--{{ metal_mockup_orientation }}">
              <button class="metal-lifestyle__open" type="button" data-framed-preview-open aria-haspopup="dialog" aria-label="Enlarge {{ product.title | escape }} framed room-scale preview">
                <div class="metal-lifestyle__visual" data-framed-visual data-framed-layout="room" data-framed-orientation="{{ metal_mockup_orientation }}">
                  <img class="metal-lifestyle__scene" src="{{ 'metal-room-couch.jpg' | asset_url }}" width="1400" height="1120" loading="lazy" alt="">
                  <div class="framed-room__frame"><div class="framed-room__mat"><img class="metal-lifestyle__art" src="{{ reference_image | image_url: width: 1600 }}" width="{{ reference_image.width }}" height="{{ reference_image.height }}" loading="lazy" alt="{{ product.title | escape }} shown to scale framed above a six-foot sofa"></div></div>
                </div>
              </button>
              <figcaption>Framed art &middot; Room scale above a 6-foot sofa &middot; Click to enlarge</figcaption>
            </figure>
            <dialog class="metal-lifestyle-lightbox" data-framed-preview-lightbox aria-label="Enlarged {{ product.title | escape }} framed preview">
              <button class="metal-lifestyle-lightbox__close" type="button" data-framed-preview-close aria-label="Close enlarged framed preview"><span aria-hidden="true">&times;</span><span>Close</span></button>
              <div class="metal-lifestyle-lightbox__content" data-framed-preview-lightbox-content></div>
            </dialog>
          </div>
        {%- endif -%}
        {%- if reference_image -%}
          <div class="metal-lifestyle-grid" data-metal-lifestyle hidden>
          <figure class="metal-lifestyle metal-lifestyle--{{ metal_mockup_orientation }}">
            <button
              class="metal-lifestyle__open"
              type="button"
              data-metal-lifestyle-open
              aria-haspopup="dialog"
              aria-label="Enlarge {{ product.title | escape }} metal print lifestyle preview"
            >
            <div class="metal-lifestyle__visual" data-metal-visual data-metal-layout="wall" data-metal-orientation="{{ metal_mockup_orientation }}">
              <img
                class="metal-lifestyle__scene"
                src="{{ metal_mockup_asset | asset_url }}"
                width="1400"
                height="1120"
                loading="lazy"
                alt=""
              >
              <div class="metal-lifestyle__panel">
                <img
                  class="metal-lifestyle__art"
                  src="{{ reference_image | image_url: width: 1600 }}"
                  srcset="{{ reference_image | image_url: width: 800 }} 800w, {{ reference_image | image_url: width: 1200 }} 1200w, {{ reference_image | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 990px) 38vw, 82vw"
                  width="{{ reference_image.width }}"
                  height="{{ reference_image.height }}"
                  loading="lazy"
                  alt="{{ product.title | escape }} shown as a metal print being hung on a wall"
                >
                <span class="metal-lifestyle__sheen" aria-hidden="true"></span>
              </div>
            </div>
            </button>
            <figcaption>Metal print &middot; Lifestyle preview &middot; Click to enlarge</figcaption>
          </figure>
          <figure class="metal-lifestyle metal-lifestyle--edge metal-lifestyle--{{ metal_mockup_orientation }}">
            <button
              class="metal-lifestyle__open"
              type="button"
              data-metal-lifestyle-open
              aria-haspopup="dialog"
              aria-label="Enlarge {{ product.title | escape }} metal print edge detail"
            >
            <div class="metal-lifestyle__visual" data-metal-visual data-metal-layout="edge" data-metal-orientation="{{ metal_mockup_orientation }}">
              <img
                class="metal-lifestyle__scene"
                src="{{ metal_edge_asset | asset_url }}"
                width="1400"
                height="1120"
                loading="lazy"
                alt=""
              >
              <div class="metal-lifestyle__panel">
                <img
                  class="metal-lifestyle__art"
                  src="{{ reference_image | image_url: width: 1600 }}"
                  srcset="{{ reference_image | image_url: width: 800 }} 800w, {{ reference_image | image_url: width: 1200 }} 1200w, {{ reference_image | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 990px) 24vw, 48vw"
                  width="{{ reference_image.width }}"
                  height="{{ reference_image.height }}"
                  loading="lazy"
                  alt="{{ product.title | escape }} shown from the edge as a thin metal print"
                >
                <span class="metal-lifestyle__sheen" aria-hidden="true"></span>
              </div>
            </div>
            </button>
            <figcaption>Metal print &middot; Edge detail &middot; Click to enlarge</figcaption>
          </figure>
          <figure class="metal-lifestyle metal-lifestyle--room metal-lifestyle--{{ metal_mockup_orientation }}">
            <button
              class="metal-lifestyle__open"
              type="button"
              data-metal-lifestyle-open
              aria-haspopup="dialog"
              aria-label="Enlarge {{ product.title | escape }} metal print room-scale preview"
            >
            <div class="metal-lifestyle__visual" data-metal-visual data-metal-layout="room" data-metal-orientation="{{ metal_mockup_orientation }}">
              <img
                class="metal-lifestyle__scene"
                src="{{ 'metal-room-couch.jpg' | asset_url }}"
                width="1400"
                height="1120"
                loading="lazy"
                alt=""
              >
              <div class="metal-room__panel">
                <img
                  class="metal-lifestyle__art"
                  src="{{ reference_image | image_url: width: 1600 }}"
                  srcset="{{ reference_image | image_url: width: 800 }} 800w, {{ reference_image | image_url: width: 1200 }} 1200w, {{ reference_image | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 990px) 18vw, 32vw"
                  width="{{ reference_image.width }}"
                  height="{{ reference_image.height }}"
                  loading="lazy"
                  alt="{{ product.title | escape }} shown to scale as a metal print above a six-foot sofa"
                >
                <span class="metal-lifestyle__sheen" aria-hidden="true"></span>
              </div>
            </div>
            </button>
            <figcaption>Metal print &middot; Room scale above a 6-foot sofa &middot; Click to enlarge</figcaption>
          </figure>
            <dialog
              class="metal-lifestyle-lightbox"
              data-metal-lifestyle-lightbox
              aria-label="Enlarged {{ product.title | escape }} metal print lifestyle preview"
            >
              <button
                class="metal-lifestyle-lightbox__close"
                type="button"
                data-metal-lifestyle-close
                aria-label="Close enlarged metal print lifestyle preview"
              >
                <span aria-hidden="true">&times;</span>
                <span>Close</span>
              </button>
              <div class="metal-lifestyle-lightbox__content" data-metal-lifestyle-lightbox-content></div>
            </dialog>
          </div>
        {%- endif -%}
      </div>
      {%- if main_image -%}
        <dialog class="product-lightbox" data-product-lightbox aria-label="Enlarged product image">
          <button class="product-lightbox__close" type="button" data-product-lightbox-close aria-label="Close enlarged image">
            <span aria-hidden="true">&times;</span>
            <span>Close</span>
          </button>
          <div class="product-lightbox__image-wrap">
            <div class="frame-preview product-lightbox__preview" data-product-lightbox-preview>
              <img
                data-product-lightbox-image
                src="{{ main_image | image_url: width: 2000 }}"
                width="{{ main_image.width }}"
                height="{{ main_image.height }}"
                alt="{{ main_image.alt | default: product.title | escape }}"
              >
            </div>
          </div>
        </dialog>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if section.settings.show_collection -%}
        <a class="eyebrow product__collection" href="{{ routes.all_products_collection_url }}">The Gallery</a>
      {%- elsif section.settings.show_vendor and product.vendor != blank -%}
        <span class="eyebrow">{{ product.vendor }}</span>
      {%- endif -%}
      <h1>{{ product.title }}</h1>
      {%- if section.settings.show_vendor and product.vendor != blank and section.settings.show_collection -%}
        <p class="product__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      {%- form 'product', product, id: form_id -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_name_lower = option.name | downcase
              assign finish_key = section.settings.finish_option_name | downcase
              assign frame_key = section.settings.frame_option_name | downcase
              assign mat_key = section.settings.mat_option_name | downcase
              assign swatch_kind = ''
              assign option_kind = 'standard'
              assign option_label = option.name
              if option_name_lower == 'title'
                assign option_kind = 'finish'
                assign option_label = 'Print option'
              elsif option_name_lower contains finish_key
                assign option_kind = 'finish'
              elsif option_name_lower contains 'size' or option_name_lower contains 'dimension'
                assign option_kind = 'size'
              elsif option_name_lower contains frame_key
                assign swatch_kind = 'frame'
                assign option_kind = 'frame'
              elsif option_name_lower contains mat_key
                assign swatch_kind = 'mat'
                assign option_kind = 'mat'
              endif
            -%}
            {%- if option_name_lower == 'title' -%}
              <div class="whcc-option-picker" data-whcc-picker>
                <fieldset class="option-group option-group--finish">
                  <legend>
                    <span class="option-group__step">01</span>
                    <span class="option-group__title">Choose your finish</span>
                    <span class="option-group__selected" data-whcc-finish-selected></span>
                  </legend>
                  <div class="option-values" data-whcc-finishes></div>
                </fieldset>
                <fieldset class="option-group option-group--size">
                  <legend>
                    <span class="option-group__step">02</span>
                    <span class="option-group__title">Choose your size</span>
                    <span class="option-group__selected" data-whcc-size-selected></span>
                  </legend>
                  <div class="option-values" data-whcc-sizes></div>
                </fieldset>
              </div>
            {%- endif -%}
            <fieldset class="option-group option-group--{{ option_kind }}" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}" data-option-kind="{{ option_kind }}"{% if option_name_lower == 'title' %} data-whcc-source hidden{% endif %}>
              <legend>
                <span class="option-group__step">{{ forloop.index | prepend: '0' }}</span>
                <span class="option-group__title">Choose your {{ option_label | downcase }}</span>
                <span class="option-group__selected" data-selected-value>{{ option.selected_value }}</span>
              </legend>
              <div class="option-values">
                {%- for value in option.values -%}
                  {%- liquid
                    assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                    assign value_lower = value | downcase
                    assign value_caption = ''
                    if option_kind == 'finish'
                      if value_lower contains 'canvas' or value_lower contains 'gallery wrap'
                        assign value_caption = 'Texture & Depth'
                      elsif value_lower contains 'metal' or value_lower contains 'aluminum' or value_lower contains 'aluminium'
                        assign value_caption = 'Clean & luminous'
                      elsif value_lower contains 'frame' or value_lower contains 'matted'
                        assign value_caption = 'A timeless finish'
                      elsif value_lower contains 'paper' or value_lower contains 'print'
                        assign value_caption = 'Archival & classic'
                      endif
                    endif
                  -%}
                  <input type="radio" id="{{ input_id }}" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ input_id }}">
                    {%- if swatch_kind != '' -%}<span class="swatch" data-swatch="{{ swatch_kind }}" data-swatch-value="{{ value | escape }}"></span>{%- endif -%}
                    <span class="option-value__content">
                      <strong>{{ value }}</strong>
                      {%- if value_caption != blank -%}<small>{{ value_caption }}</small>{%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="product__price" data-price>
          {{ current_variant.price | money }}
          {%- if current_variant.compare_at_price > current_variant.price -%} <s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
        </div>

        <div class="product__buy">
          <div class="qty">
            <button type="button" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
            <label class="visually-hidden" for="{{ form_id }}-qty">Quantity</label>
            <input id="{{ form_id }}-qty" type="number" name="quantity" value="1" min="1">
            <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
          </div>
          <button class="button button--full" type="submit" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </button>
          {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
          {%- if section.settings.buy_note != blank -%}<p class="product__buy-note">{{ section.settings.buy_note }}</p>{%- endif -%}
        </div>
      {%- endform -%}

      <div class="product__accordions">
        <details class="accordion accordion--story">
          <summary>The Story Behind the Shot</summary>
          <div class="rte">
            {%- if product.description != blank -%}
              {{ product.description }}
            {%- else -%}
              <p>The story behind this photograph is coming soon.</p>
            {%- endif -%}
            {%- if product.handle == 'aspen-icm' -%}
              <p class="product-story__journal-link">
                <a href="/blogs/behind-the-lense/aspens-in-motion-at-oxbow-bend">Read More in My Field Journal about this image</a>
              </p>
            {%- endif -%}
          </div>
        </details>
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading }}</summary>
            <div class="rte">
              {{ block.settings.text }}
              {%- if block.settings.custom_liquid != blank -%}
                <div class="product-details__extra">{{ block.settings.custom_liquid }}</div>
              {%- endif -%}
              {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
    </div>
  </div>
  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "frame_preview", "label": "Show live frame and mat preview", "default": true },
    { "type": "text", "id": "finish_option_name", "label": "Name of the finish option", "default": "Finish", "info": "Must match the option name on products that offer Canvas, Metal, or Matted & framed. WHCC's default Title option is recognized automatically." },
