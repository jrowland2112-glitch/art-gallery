{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign main_image = current_variant.featured_image | default: product.featured_image
  assign form_id = 'product-form-' | append: section.id
  assign use_frame_preview = section.settings.frame_preview
  assign hide_product_thumbnails = false
  for product_option_name in product.options
    assign product_option_name_lower = product_option_name | downcase
    if product_option_name_lower == 'title'
      assign use_frame_preview = false
      assign hide_product_thumbnails = true
    endif
  endfor
-%}
<section
  class="section product-section"
  data-product
  data-finish-option="{{ section.settings.finish_option_name | escape }}"
  data-frame-option="{{ section.settings.frame_option_name | escape }}"
  data-mat-option="{{ section.settings.mat_option_name | escape }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="page-width">
    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">The Gallery</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product">
    <div class="product__media">
      <div class="product__stage">
        <div class="frame-preview" {% if use_frame_preview %}data-frame-preview{% endif %}>
          {%- if main_image -%}
            <img
              data-main-image
              src="{{ main_image | image_url: width: 1600 }}"
              srcset="{{ main_image | image_url: width: 800 }} 800w, {{ main_image | image_url: width: 1200 }} 1200w, {{ main_image | image_url: width: 1600 }} 1600w"
              sizes="(min-width: 990px) 55vw, 100vw"
              width="{{ main_image.width }}"
              height="{{ main_image.height }}"
              alt="{{ main_image.alt | default: product.title | escape }}"
            >
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if main_image -%}
          <button class="product__enlarge" type="button" data-product-lightbox-open aria-haspopup="dialog">
            Enlarge
          </button>
        {%- endif -%}
        {%- if use_frame_preview -%}
          <div class="product__stage-copy">
            {%- if section.settings.stage_caption != blank -%}
              <p class="product__stage-caption" data-finish-caption>{{ section.settings.stage_caption }}</p>
            {%- endif -%}
            <p class="frame-preview__note">Frame and mat preview is for illustration. Actual finish may vary slightly.</p>
          </div>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 and hide_product_thumbnails == false -%}
        <div class="product__thumbs">
          {%- for image in product.images -%}
            <button type="button" data-thumb="{{ image | image_url: width: 1600 }}" aria-current="{% if image == main_image %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">
              {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if main_image -%}
        <dialog class="product-lightbox" data-product-lightbox aria-label="Enlarged product image">
          <button class="product-lightbox__close" type="button" data-product-lightbox-close aria-label="Close enlarged image">
            <span aria-hidden="true">&times;</span>
            <span>Close</span>
          </button>
          <div class="product-lightbox__image-wrap">
            <img
              data-product-lightbox-image
              src="{{ main_image | image_url: width: 2000 }}"
              width="{{ main_image.width }}"
              height="{{ main_image.height }}"
              alt="{{ main_image.alt | default: product.title | escape }}"
            >
          </div>
        </dialog>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if section.settings.show_collection -%}
        <a class="eyebrow product__collection" href="{{ routes.all_products_collection_url }}">The Gallery</a>
      {%- elsif section.settings.show_vendor and product.vendor != blank -%}
        <span class="eyebrow">{{ product.vendor }}</span>
      {%- endif -%}
      <h1>{{ product.title }}</h1>
      {%- if section.settings.show_vendor and product.vendor != blank and section.settings.show_collection -%}
        <p class="product__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      {%- form 'product', product, id: form_id -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_name_lower = option.name | downcase
              assign finish_key = section.settings.finish_option_name | downcase
              assign frame_key = section.settings.frame_option_name | downcase
              assign mat_key = section.settings.mat_option_name | downcase
              assign swatch_kind = ''
              assign option_kind = 'standard'
              assign option_label = option.name
              if option_name_lower == 'title'
                assign option_kind = 'finish'
                assign option_label = 'Print option'
              elsif option_name_lower contains finish_key
                assign option_kind = 'finish'
              elsif option_name_lower contains 'size' or option_name_lower contains 'dimension'
                assign option_kind = 'size'
              elsif option_name_lower contains frame_key
                assign swatch_kind = 'frame'
                assign option_kind = 'frame'
              elsif option_name_lower contains mat_key
                assign swatch_kind = 'mat'
                assign option_kind = 'mat'
              endif
            -%}
            {%- if option_name_lower == 'title' -%}
              <div class="whcc-option-picker" data-whcc-picker>
                <fieldset class="option-group option-group--finish">
                  <legend>
                    <span class="option-group__step">01</span>
                    <span class="option-group__title">Choose your finish</span>
                    <span class="option-group__selected" data-whcc-finish-selected></span>
                  </legend>
                  <div class="option-values" data-whcc-finishes></div>
                </fieldset>
                <fieldset class="option-group option-group--size">
                  <legend>
                    <span class="option-group__step">02</span>
                    <span class="option-group__title">Choose your size</span>
                    <span class="option-group__selected" data-whcc-size-selected></span>
                  </legend>
                  <div class="option-values" data-whcc-sizes></div>
                </fieldset>
              </div>
            {%- endif -%}
            <fieldset class="option-group option-group--{{ option_kind }}" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}" data-option-kind="{{ option_kind }}"{% if option_name_lower == 'title' %} data-whcc-source hidden{% endif %}>
              <legend>
                <span class="option-group__step">{{ forloop.index | prepend: '0' }}</span>
                <span class="option-group__title">Choose your {{ option_label | downcase }}</span>
                <span class="option-group__selected" data-selected-value>{{ option.selected_value }}</span>
              </legend>
              <div class="option-values">
                {%- for value in option.values -%}
                  {%- liquid
                    assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                    assign value_lower = value | downcase
                    assign value_caption = ''
                    if option_kind == 'finish'
                      if value_lower contains 'canvas' or value_lower contains 'gallery wrap'
                        assign value_caption = 'Texture & Depth'
                      elsif value_lower contains 'metal' or value_lower contains 'aluminum' or value_lower contains 'aluminium'
                        assign value_caption = 'Clean & luminous'
                      elsif value_lower contains 'frame' or value_lower contains 'matted'
                        assign value_caption = 'A timeless finish'
                      elsif value_lower contains 'paper' or value_lower contains 'print'
                        assign value_caption = 'Archival & classic'
                      endif
                    endif
                  -%}
                  <input type="radio" id="{{ input_id }}" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ input_id }}">
                    {%- if swatch_kind != '' -%}<span class="swatch" data-swatch="{{ swatch_kind }}" data-swatch-value="{{ value | escape }}"></span>{%- endif -%}
                    <span class="option-value__content">
                      <strong>{{ value }}</strong>
                      {%- if value_caption != blank -%}<small>{{ value_caption }}</small>{%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        <div class="product__price" data-price>
          {{ current_variant.price | money }}
          {%- if current_variant.compare_at_price > current_variant.price -%} <s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
        </div>

        <div class="product__buy">
          <div class="qty">
            <button type="button" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
            <label class="visually-hidden" for="{{ form_id }}-qty">Quantity</label>
            <input id="{{ form_id }}-qty" type="number" name="quantity" value="1" min="1">
            <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
          </div>
          <button class="button button--full" type="submit" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </button>
          {%- if section.settings.show_dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
          {%- if section.settings.buy_note != blank -%}<p class="product__buy-note">{{ section.settings.buy_note }}</p>{%- endif -%}
        </div>
      {%- endform -%}

      <div class="product__accordions">
        <details class="accordion accordion--story">
          <summary>The Story Behind the Shot</summary>
          <div class="rte">
            {%- if product.description != blank -%}
              {{ product.description }}
            {%- else -%}
              <p>The story behind this photograph is coming soon.</p>
            {%- endif -%}
          </div>
        </details>
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading }}</summary>
            <div class="rte">
              {{ block.settings.text }}
              {%- if block.settings.custom_liquid != blank -%}
                <div class="product-details__extra">{{ block.settings.custom_liquid }}</div>
              {%- endif -%}
              {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
    </div>
  </div>
  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "frame_preview", "label": "Show live frame and mat preview", "default": true },
    { "type": "text", "id": "finish_option_name", "label": "Name of the finish option", "default": "Finish", "info": "Must match the option name on products that offer Canvas, Metal, or Matted & framed. WHCC's default Title option is recognized automatically." },
    { "type": "text", "id": "frame_option_name", "label": "Name of the frame option", "default": "Frame", "info": "Must match the option name on your products, e.g. \"Frame\"" },
    { "type": "text", "id": "mat_option_name", "label": "Name of the mat option", "default": "Mat", "info": "e.g. \"Mat\" or \"Mount\"" },
    { "type": "text", "id": "stage_caption", "label": "Preview caption", "default": "Your art, your way · Finish preview" },
    { "type": "checkbox", "id": "show_collection", "label": "Show collection above title", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor above title", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show \"Buy it now\" button", "default": false },
    { "type": "text", "id": "buy_note", "label": "Note below Add to cart", "default": "Made to order · Secure checkout" }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "liquid", "id": "custom_liquid", "label": "Additional formatted details", "info": "Optional formatted content, such as the framed-art dimensions table." },
        { "type": "page", "id": "page", "label": "Or show content from a page" }
      ]
    }
  ]
}
{% endschema %}
