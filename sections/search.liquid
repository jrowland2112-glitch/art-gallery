<section class="section">
  <div class="page-width">
    <h1 class="text-center">Search prints</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="page-width--narrow newsletter-form" style="margin: 0 auto 3rem">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <label class="visually-hidden" for="search-q">Search prints</label>
      <input id="search-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search by title, place, or subject">
      <button class="button" type="submit">Search</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        <p class="muted">{{ search.results_count }} results for "{{ search.terms | escape }}"</p>
        <div class="grid" style="--cols: 3; --cols-mobile: 1;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, ratio: '4 / 3', contain: true %}
            {%- else -%}
              <a class="card" href="{{ item.url }}">
                <div class="card__info">
                  <span class="eyebrow">{{ item.object_type | capitalize }}</span>
                  <h2 class="card__title">{{ item.title }}</h2>
                  <p class="card__meta">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pages">{{ paginate | default_pagination: previous: '&larr;', next: '&rarr;' }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
