{%- assign url = section.settings.link | default: settings.social_instagram -%}
<section class="section section--tight{% if section.settings.divider %} section--ruled{% endif %}">
  <div class="page-width text-center">
    <h2 class="display-italic social-cta__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.label != blank -%}
      <p class="social-cta__link">
        {% render 'icon-instagram' %}
        <a class="text-link" href="{{ url | default: '#' }}" target="_blank" rel="noopener">{{ section.settings.label }} <span aria-hidden="true">&#8599;</span></a>
      </p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="social-cta__feed">
        {%- for block in section.blocks -%}
          <div class="social-cta__app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="social-cta__app-help">Add the Instafeed app block here to show the latest Instagram posts.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram call-out",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the light." },
    { "type": "text", "id": "label", "label": "Link text", "default": "Instagram · @jrowland" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the Instagram link in Theme settings → Social media" },
    { "type": "checkbox", "id": "divider", "label": "Line above section", "default": true }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "max_blocks": 1,
  "presets": [ { "name": "Instagram call-out" } ]
}
{% endschema %}
