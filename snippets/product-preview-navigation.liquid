<div class="product-preview-carousel__navigation" aria-label="Lifestyle preview navigation">
  <button
    class="product-preview-carousel__arrow product-preview-carousel__arrow--previous"
    type="button"
    data-preview-previous
    aria-label="Show previous preview image"
    disabled
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m14.5 5-7 7 7 7"></path>
    </svg>
  </button>
  <span class="product-preview-carousel__position" data-preview-position aria-live="polite">1 of 3</span>
  <button
    class="product-preview-carousel__arrow product-preview-carousel__arrow--next"
    type="button"
    data-preview-next
    aria-label="Show next preview image"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m9.5 5 7 7-7 7"></path>
    </svg>
  </button>
</div>
